
# ================================
# Python bytecode / cache
# ================================
__pycache__/
*.py[cod]
*$py.class

# ================================
# Virtual environments
# ================================
.venv/
venv/
env/
ENV/

# ================================
# uv / lock / cache
# ================================
.uv/
.uv-cache/

# ================================
# Test / coverage artifacts
# ================================
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ================================
# Build / packaging
# ================================
build/
dist/
*.egg-info/

# ================================
# Data files (generated)
# ================================
data/raw/*.json
data/raw/*.csv
data/processed/*
!data/processed/README.md

# ================================
# Logs / temp files
# ================================
*.log
*.tmp
*.temp

# ================================
# OS-specific junk
# ================================
# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# WSL
*.lnk

# ================================
# IDE / Editor configs
# ================================
# VS Code
.vscode/

# PyCharm / IntelliJ
.idea/

# Vim
*.swp
*.swo
*.swn

# ================================
# Jupyter
# ================================
.ipynb_checkpoints/

# ================================
# Shell / misc
# ================================
*.sh~
*.bak
